{
  "name": "@captiveorigins/payload-plugin-events",
  "version": "0.1.0",
  "description": "Events for Payload: events and their dates, with repeat rules in the event's timezone, near-me search, appearances, merge and split, and calendar files.",
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "events",
    "calendar",
    "recurring-events",
    "rrule",
    "ics"
  ],
  "license": "MIT",
  "homepage": "https://github.com/CaptiveOrigins/payload-plugin-events#readme",
  "bugs": {
    "url": "https://github.com/CaptiveOrigins/payload-plugin-events/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptiveOrigins/payload-plugin-events.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "payload": "^3.80.0",
    "@payloadcms/ui": "^3.80.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/ui": "^3.92.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "graphql": "^16.14.2",
    "mongodb-memory-server": "^11.3.0",
    "next": "^16.4.5",
    "payload": "3.92.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
